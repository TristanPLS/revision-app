# ============================================================
#  revision-app — environnement
#
#  TOUT EST OPTIONNEL pour un déploiement Docker : `docker compose up -d`
#  fonctionne sans .env, et la clé IA se configure depuis l'interface
#  (page Réglages). Ce fichier ne sert qu'aux overrides et au dev natif.
#
#  Pour l'utiliser : copier en .env puis décommenter/éditer.
#  .env est gitignoré ; les lignes [SECRET] ne doivent JAMAIS être commitées.
# ============================================================

# ---- PostgreSQL (conteneur `postgres`) --------------------
#POSTGRES_USER=revision
#POSTGRES_PASSWORD=change-me-long-random            # [SECRET]
#POSTGRES_DB=revision

# ---- URL base de données (backend + sqlx) -----------------
# Requise UNIQUEMENT en dev natif (cargo run) — en Docker elle est composée
# automatiquement à partir des variables POSTGRES_*.
# DEV (binaire natif, Postgres dev publié sur localhost:5433) :
#DATABASE_URL=postgres://revision:change-me-long-random@localhost:5433/revision   # [SECRET-ish]

# ---- Ports / réseau ---------------------------------------
#BACKEND_PORT=8080
#FRONTEND_PORT=3000
# Adresse d'écoute du frontend publié par Docker. 127.0.0.1 = local seulement
# (défaut, recommandé). 0.0.0.0 = accessible depuis le réseau local — lis
# d'abord l'encadré Sécurité du README (application sans authentification).
#BIND_ADDR=127.0.0.1
# Fuseau horaire (streak, garde-fous sommeil 22h-5h, frontière de journée)
#TZ=Europe/Paris

# ---- Frontend (dev natif uniquement) ----------------------
# Utilisé par next.config rewrites pour joindre le backend.
# DEV (natif) : http://localhost:8080   PROD (compose) : injecté automatiquement
#BACKEND_INTERNAL_URL=http://localhost:8080

# ---- IA (optionnel — préférer la page Réglages de l'app) --
# Ces variables ne sont que des valeurs initiales : ce qui est enregistré
# dans Réglages (stocké en base) a priorité.
#AI_PROVIDER=gemini                                  # gemini | openai | anthropic
#AI_MODEL=gemma-4-31b-it                             # Gemma 4 (gratuit, ~1500 req/jour sur AI Studio)
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#GEMINI_API_KEY=PUT-YOUR-AI-STUDIO-KEY-HERE          # [SECRET] backend uniquement, jamais NEXT_PUBLIC_
# Taille max (caractères) du cours injecté dans les prompts IA
#AI_MAX_SOURCE_CHARS=16000

# ---- SRS (FSRS) -------------------------------------------
#FSRS_RETENTION=0.9                                  # rétention cible (0.7–0.97)

# ---- Logs -------------------------------------------------
#RUST_LOG=info,revision_backend=debug
