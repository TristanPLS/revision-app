# ============================================================
#  revision-app — environnement
#  Copier en .env et remplir. .env est gitignoré.
#  Les lignes [SECRET] ne doivent JAMAIS être commitées.
# ============================================================

# ---- PostgreSQL (conteneur `postgres`) --------------------
POSTGRES_USER=revision
POSTGRES_PASSWORD=change-me-long-random            # [SECRET]
POSTGRES_DB=revision

# ---- URL base de données (backend + sqlx) -----------------
# DEV (binaire natif, Postgres publié sur localhost) :
#   postgres://USER:PASSWORD@localhost:5432/DB
# PROD (en conteneur) : host = nom de service "postgres"
#   postgres://USER:PASSWORD@postgres:5432/DB
DATABASE_URL=postgres://revision:change-me-long-random@localhost:5432/revision   # [SECRET-ish]

# ---- Ports ------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ---- Frontend ---------------------------------------------
# Utilisé par next.config rewrites pour joindre le backend.
# DEV (natif) : http://localhost:8080   PROD (compose) : http://backend:8080
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Revision

# ---- IA (Google AI Studio / Gemma) ------------------------
AI_PROVIDER=gemini
AI_MODEL=gemma-3-27b-it                             # configurable ; tout id servi par l'endpoint marche
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=PUT-YOUR-AI-STUDIO-KEY-HERE          # [SECRET] backend uniquement, jamais NEXT_PUBLIC_

# ---- SRS (FSRS) -------------------------------------------
FSRS_RETENTION=0.9                                  # rétention cible (0.7–0.97)

# ---- Logs -------------------------------------------------
RUST_LOG=info,revision_backend=debug

# ---- Tailscale (optionnel, déploiement) -------------------
# Non requis pour l'option recommandée (client Windows natif + tailscale serve).
# TS_AUTHKEY=tskey-auth-xxxxxxxx                     # [SECRET]
